{
  "name": "yueqi-open",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first AI companion. Bring your own OpenAI-compatible API.",
  "scripts": {
    "dev": "vite --config frontend/vite.config.js",
    "build": "vite build --config frontend/vite.config.js",
    "preview": "vite preview --config frontend/vite.config.js --host 127.0.0.1 --port 4173",
    "server": "node backend/index.mjs",
    "start": "node scripts/start.mjs",
    "android": "npm run build && npx cap sync android",
    "build:android": "node scripts/build-android.mjs"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^6.0.0",
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.1",
    "@capacitor/filesystem": "^6.0.3",
    "@capacitor/local-notifications": "^6.1.2",
    "@capacitor/preferences": "^6.0.3",
    "@capacitor/status-bar": "^6.0.0",
    "@openclaw/ai": "2026.7.1-2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "fflate": "^0.8.3",
    "json5": "2.2.3",
    "page-flip": "^2.0.7",
    "pixi.js": "^8.19.0",
    "typebox": "^1.3.11"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.1",
    "concurrently": "^10.0.3",
    "lucide": "^1.21.0",
    "vite": "^5.4.21"
  },
  "engines": {
    "node": ">=20"
  }
}
