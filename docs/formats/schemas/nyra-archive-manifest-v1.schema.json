{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nyra.app/schemas/nyra-archive-manifest-v1.schema.json",
  "title": "Nyra Data Archive Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "archiveId",
    "createdAt",
    "producer",
    "entries",
    "restore"
  ],
  "properties": {
    "schema": {
      "const": "nyra.archive.manifest"
    },
    "version": {
      "const": 1
    },
    "archiveId": {
      "type": "string",
      "format": "uuid"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "platform": {
          "type": "string",
          "maxLength": 40
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "legacySchema": {
          "const": "yueqi-companion-export"
        },
        "legacyVersion": {
          "enum": [1, 2]
        }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "category", "mediaType", "size", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
          },
          "category": {
            "enum": ["user-data", "entity", "resource-original", "resource-metadata", "derivative"]
          },
          "mediaType": {
            "type": "string",
            "minLength": 3,
            "maxLength": 127,
            "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1073741824
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "required": {
            "type": "boolean",
            "default": true
          },
          "authority": {
            "enum": ["authoritative", "rebuildable"]
          }
        }
      }
    },
    "restore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy"],
      "properties": {
        "strategy": {
          "const": "staged-atomic"
        },
        "minimumAppVersion": {
          "type": "string",
          "maxLength": 40
        }
      }
    },
    "extensions": {
      "type": "object"
    }
  }
}
