{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nyra.app/schemas/nychar-worldbook-v1.schema.json",
  "title": "Nyra Character Worldbook v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "entries"],
  "properties": {
    "schema": {
      "const": "nyra.character.worldbook"
    },
    "version": {
      "const": 1
    },
    "entries": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "content"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "name": {
            "type": "string",
            "maxLength": 160
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100000
          },
          "keywords": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "priority": {
            "type": "integer",
            "minimum": -1000,
            "maximum": 1000
          }
        }
      }
    }
  }
}
