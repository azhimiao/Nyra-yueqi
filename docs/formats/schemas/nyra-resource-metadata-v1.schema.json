{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nyra.app/schemas/nyra-resource-metadata-v1.schema.json",
  "title": "Nyra Resource Metadata v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "id", "kind", "importedAt", "original"],
  "properties": {
    "schema": {
      "const": "nyra.resource.metadata"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "kind": {
      "enum": ["book", "music", "image"]
    },
    "title": {
      "type": "string",
      "maxLength": 500
    },
    "creator": {
      "type": "string",
      "maxLength": 500
    },
    "language": {
      "type": "string",
      "maxLength": 35
    },
    "importedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["local-file", "generated", "legacy-import", "other"]
        },
        "label": {
          "type": "string",
          "maxLength": 500
        },
        "uri": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048
        }
      }
    },
    "original": {
      "type": "object",
      "additionalProperties": false,
      "required": ["filename", "mediaType", "size", "sha256", "immutable"],
      "properties": {
        "filename": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[^/\\\\]+$"
        },
        "mediaType": {
          "type": "string",
          "minLength": 3,
          "maxLength": 127,
          "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967296
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "immutable": {
          "const": true
        }
      }
    },
    "durationMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400000
    },
    "derivatives": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "role", "path", "mediaType", "size", "sha256", "sourceSha256"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 96
          },
          "role": {
            "enum": ["extracted-text", "thumbnail", "transcode", "waveform", "transcript", "summary", "embedding", "other"]
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^resources/[a-f0-9]{64}/derivatives/[A-Za-z0-9._-]+$"
          },
          "mediaType": {
            "type": "string",
            "minLength": 3,
            "maxLength": 127
          },
          "size": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1073741824
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "sourceSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "tool": {
            "type": "string",
            "maxLength": 160
          }
        }
      }
    },
    "extensions": {
      "type": "object"
    }
  }
}
