# Yueqi server
# Production should listen on the private/container interface and be exposed through HTTPS.
HOST=127.0.0.1
PORT=8787

# Comma-separated browser origins allowed to call the server.
# Example: https://app.example.com,https://admin.example.com
YUEQI_CORS_ORIGINS=

# Client-facing service address. Android/Windows production packages must use a reachable HTTPS URL.
VITE_YUEQI_SERVICE_BASE=http://127.0.0.1:8787

# Server authentication. Leave blank for local development only.
# YUEQI_LOCAL_TOKEN is the client-to-server access token.
# YUEQI_AUTH_SECRET signs authenticated user sessions.
YUEQI_LOCAL_TOKEN=
YUEQI_AUTH_SECRET=
YUEQI_ADMIN_TOKEN=
YUEQI_PUBLIC_SERVER=1
# Atomic server-side persistence. Keep both files on durable storage and back
# them up together; never package them into the client.
YUEQI_DATA_FILE=./server/data/store.json
YUEQI_ECONOMY_DATA_FILE=./server/data/economy.json
# Nyra Hosted Credits ledger. Dedicated Postgres database — never CogPrism
# DATABASE_URL / ai_memory_os / StudioUser.credits.
# Public servers fail closed without this URL.
# YUEQI_BILLING_DATABASE_URL=postgres://nyra_billing:...@127.0.0.1:5432/nyra_billing
# Tests only: YUEQI_BILLING_DRIVER=pglite and YUEQI_BILLING_ALLOW_PGLITE=1
# In-app notices (announcements / forced stay windows). File is not packaged into the client.
# YUEQI_NOTICES_FILE=./server/data/notices.json
# Extra https hosts allowed on notice buttons, comma-separated:
# YUEQI_NOTICE_LINK_HOSTS=
# App update channel (preferred: JSON file on durable storage)
# YUEQI_UPDATE_MANIFEST_FILE=./server/data/update-manifest.json
# Fallback when the file is absent:
# YUEQI_UPDATE_LATEST_VERSION=1.0.0
# YUEQI_UPDATE_MINIMUM_VERSION=1.0.0
# YUEQI_UPDATE_MANDATORY=0
# YUEQI_UPDATE_DOWNLOAD_URL=https://download.memprism.com/nyra-latest.apk

# Nyra Hosted = Volcengine Ark only. Users pick Standard / High; server maps the model.
# ARK_*_MODEL env vars are not a Hosted routing path.
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Hosted doubao-seed-2-1 companion replies: disabled (default), enabled, or preserve.
# Other purposes and BYOK keep their provider defaults.
YUEQI_COMPANION_THINKING=disabled
#
# Official Ark list prices live in server/billing/hosted-catalog.mjs (2026-08-15).
# Optional per-model override (CNY). Only Ark modelIds.
# YUEQI_HOSTED_MODEL_PRICES={"doubao-seed-character-260628":{"modality":"text","inputCnyPerMillion":0.8,"outputCnyPerMillion":2}}
YUEQI_HOSTED_MODEL_PRICES=
# Credits conversion scale (not a supplier price):
# YUEQI_CREDIT_CNY=0.01
# YUEQI_BILLING_MARKUP=2
# YUEQI_AGENT_MAX_CREDITS=120

# Legacy BYOK-only aliases (not used by Nyra Hosted):
# YUEQI_MODEL_BASE_URL=
# YUEQI_MODEL_API_KEY=
# YUEQI_MODEL=

# Nyra Hosted Billing Credit packs are purchase amounts, not token allowances.

# Whop one-time Credits checkout. Keep server values secret.
# Enable the client button only after sandbox/live evidence exists.
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
# Public checkout ids. This open-source tree does not enable Whop checkout.
WHOP_COMPANY_ID=
YUEQI_PUBLIC_APP_URL=
VITE_WHOP_ENABLED=0

# Optional BYOK speech (OpenAI / ElevenLabs / Volcengine openspeech).
YUEQI_TTS_API_KEY=
YUEQI_TTS_VOICE_ID=
YUEQI_TTS_MODEL=
YUEQI_STT_API_KEY=
YUEQI_STT_MODEL=

# Nyra Hosted cloud speech (Volcengine openspeech — separate from Ark chat key).
# Required for paid subscribers to use TTS/STT without BYOK keys.
# Use either 体验中心 API Key (recommended) or legacy app id + access token.
YUEQI_SPEECH_API_KEY=
# Legacy 语音技术控制台 credentials (optional when API Key is set):
YUEQI_SPEECH_APP_ID=
YUEQI_SPEECH_ACCESS_TOKEN=
# Speaker / voice id, e.g. zh_female_cancan_mars_bigtts
YUEQI_SPEECH_VOICE_TYPE=
# Billing unit prices (CNY). Hosted speech stays OFF without both prices.
YUEQI_SPEECH_TTS_CNY_PER_10K_CHARS=3
YUEQI_SPEECH_STT_CNY_PER_MINUTE=0.02
# Optional overrides:
# YUEQI_SPEECH_TTS_RESOURCE_ID=volc.tts.default   # 体验中心 default 项目
# YUEQI_SPEECH_TTS_RESOURCE_ID=seed-tts-2.0       # 豆包 TTS 2.0
# YUEQI_SPEECH_TTS_CLUSTER=volcano_tts
# YUEQI_SPEECH_STT_RESOURCE_ID=volc.bigasr.auc_turbo

# Optional BYOK image overrides (Hosted image uses ARK_IMAGE_MODEL above).
YUEQI_IMAGE_BASE_URL=
YUEQI_IMAGE_API_KEY=
YUEQI_IMAGE_MODEL=

# Optional web retrieval. Configure one provider key.
BRAVE_API_KEY=
TAVILY_API_KEY=
# Generic alias accepted by both providers; normally leave blank when using a provider-specific key.
YUEQI_WEB_SEARCH_API_KEY=

# GitHub update checks and community links.
GITHUB_REPO=yueqi-open/companion
YUEQI_QQ_GROUP=1034044082
YUEQI_DISCORD=CogPrism
YUEQI_CONTACT_WECHAT=azhimiaoo
YUEQI_CONTACT_QQ=3804762525
YUEQI_CONTACT_EMAIL=3804762525@qq.com
YUEQI_DOCS=https://github.com/yueqi-open/companion

# Public support contacts embedded in Web/APK builds.
VITE_YUEQI_CONTACT_DISCORD=CogPrism
VITE_YUEQI_CONTACT_WECHAT=azhimiaoo
VITE_YUEQI_CONTACT_QQ_GROUP=1034044082
VITE_YUEQI_CONTACT_EMAIL=3804762525@qq.com
VITE_YUEQI_CONTACT_QQ=3804762525

# Optional Volcengine Ark Seedream image generation (local asset script only).
# ARK_IMAGE_MODEL=doubao-seedream-4-5-251128
