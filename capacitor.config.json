{
  "appId": "app.yueqi.open",
  "appName": "月栖",
  "webDir": "www",
  "server": {
    "androidScheme": "https",
    "cleartext": false
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_icon_config_sample",
      "iconColor": "#9f5963"
    },
    "CapacitorSQLite": {
      "iosDatabaseLocation": "Library/CapacitorDatabase",
      "iosIsEncryption": true,
      "iosKeychainPrefix": "yueqi-companion",
      "iosBiometric": {
        "biometricAuth": false,
        "biometricTitle": "Unlock Yueqi database"
      },
      "androidIsEncryption": true,
      "androidBiometric": {
        "biometricAuth": false,
        "biometricTitle": "Unlock Yueqi database",
        "biometricSubTitle": "Confirm to open the encrypted local store"
      }
    }
  }
}
